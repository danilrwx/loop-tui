[Unit]
Description=Loop TUI background notifications
After=dbus.socket

[Service]
ExecStart=%h/.local/bin/loopd
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
# Keep the idle Go heap and GC worker pool small.
Environment=GOMEMLIMIT=8MiB
Environment=GOGC=50
Environment=GOMAXPROCS=2
Restart=always
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true

[Install]
WantedBy=default.target
